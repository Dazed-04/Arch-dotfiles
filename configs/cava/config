[general]
framerate = 60
autosens = 1
bars = 0
bar_width = 2
bar_spacing = 1

[input]
method = fifo
source = /tmp/mpd.fifo

[output]
# Required for rmpc to display the visualizer internally
method = raw
raw_target = /dev/stdout
data_format = binary
bit_format = 16bit

[color]
# Using Matugen to create a dynamic gradient
gradient = 1
gradient_count = 8
gradient_color_1 = '#c3c0ff'
gradient_color_2 = '#424178'
gradient_color_3 = '#c7c4dd'
gradient_color_4 = '#464559'
gradient_color_5 = '#eab9d2'
gradient_color_6 = '#603c50'
gradient_color_7 = '#ffb4ab'
gradient_color_8 = '#928f9a'

[smoothing]
noise_reduction = 77
